# Copy to .env (gitignored) for local runs; `npx expo start` reads it. EAS builds don't upload
# .env: they take the same names from each build profile's `env` in eas.json. Leave a value
# empty and Settings → About leaves that row out.
EXPO_PUBLIC_PRIVACY_URL=https://winzero.app/privacy
EXPO_PUBLIC_SUPPORT_URL=https://winzero.app/support
# Never set EXPO_PUBLIC_APP_VARIANT here: it picks Win Zero or Win Zero Plus (app.config.ts), and
# a value in .env would quietly turn every run and local build into Plus. Use the :plus scripts.
