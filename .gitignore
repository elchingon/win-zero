credentials.json
credentials/
*service-account*.json
*.keystore
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# the other app's Xcode project, waiting for the next switch (scripts/prebuild.mjs)
/.ios-parked

# local release builds (npm run build:android)
/build
