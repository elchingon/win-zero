{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_PRIVACY_URL": "https://winzero.app/privacy",
        "EXPO_PUBLIC_SUPPORT_URL": "https://winzero.app/support"
      }
    },
    "perf": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_PERF_BUILD": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PRIVACY_URL": "https://winzero.app/privacy",
        "EXPO_PUBLIC_SUPPORT_URL": "https://winzero.app/support"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
